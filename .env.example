# Set these in Vercel → Project → Settings → Environment Variables. Never commit real values
# and never prefix them with VITE_ (that would expose them to the browser).

# Contact form (api/contact.ts) — Brevo transactional email
BREVO_API_KEY=
BREVO_MAIL_FROM_EMAIL=bandaruharivansh@gmail.com
CONTACT_RECIPIENT_EMAIL=bandaruharivansh@gmail.com

# Visitor counter (api/visits.ts) — Upstash Redis.
# Connecting Upstash from Vercel → Storage → Marketplace injects KV_REST_API_URL / KV_REST_API_TOKEN
# automatically; set these two only if you create the database on upstash.com yourself.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
